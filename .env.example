# ──────────────────────────────────────────────────────────────────────────
# Strut — production environment variables
# Copy to .env locally (or set these in Vercel → Project → Environment).
# Local dev needs NONE of these: the app runs on an embedded PGlite database
# and shows phone codes on screen when SMS isn't wired.
# ──────────────────────────────────────────────────────────────────────────

# ── Database (REQUIRED in production) ───────────────────────────────────────
# A pooled Postgres connection string. Neon (recommended), Supabase, RDS…
# Migrations run automatically on deploy (npm run build → db:migrate).
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# ── Session secret (REQUIRED in production) ─────────────────────────────────
# Long random string used to sign session cookies/JWTs. Generate one with:
#   openssl rand -hex 32
# Keep it stable or every signed-in user is logged out on the next cold start.
BETTER_AUTH_SECRET=

# ── Public app URL ──────────────────────────────────────────────────────────
# The canonical https origin of the app. On Vercel this is auto-detected from
# VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL, but set it explicitly for a
# custom domain so OAuth redirect URIs match exactly.
BETTER_AUTH_URL=https://strut.example.com

# ── Photo / video storage (REQUIRED for uploads in production) ──────────────
# Create ONE Vercel Blob store (Storage → Blob). One store is enough to scale
# very far: reads are served from the CDN and never hit the app. Add a second
# store only to split media types or regions.
BLOB_READ_WRITE_TOKEN=

# ── Google sign-in (optional but recommended) ───────────────────────────────
# Google Cloud Console → OAuth client (Web). Authorized redirect URI:
#   <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── X / Twitter sign-in (optional) ──────────────────────────────────────────
# X Developer Portal → OAuth 2.0 client. Callback / redirect URI:
#   <BETTER_AUTH_URL>/api/auth/callback/twitter
X_CLIENT_ID=
X_CLIENT_SECRET=

# ── Phone SMS codes (optional — phone sign-in works without it in dev) ──────
# Twilio. When unset, phone OTP codes are shown on the verify screen (dev).
# Set all three to deliver real texts in production.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Or, if you use a Messaging Service (sender pool / advanced opt-outs), set this
# INSTEAD of TWILIO_FROM_NUMBER. Grab the Messaging Service SID at
# console.twilio.com → Messaging → Services.
TWILIO_MESSAGING_SERVICE_SID=
# Optional: cap what a phone-abuse storm can cost you. Strut rate-limits phone
# starts/verifies itself, but a Twilio-side stop is the real backstop. Set a
# usage trigger in the Twilio console before you go live (see docs/twilio.md).

# ── Admin control panel (TEST ENVIRONMENTS ONLY) ────────────────────────────
# /admin is a signed-in console that generates seed profiles (persona -> bio ->
# photo -> human edit -> approval) and can suspend or permanently delete any
# profile in the database.
#
# ⚠️  THE DEFAULTS ARE COMMITTED LITERALS.
# With none of these set, the app bootstraps an admin account using the
# fallbacks in src/lib/server/secrets.server.ts. That is deliberate (the
# operator of the current preview cannot set env vars) and it is NOT safe for
# production: the password is in a public git history.
#
# Set these and the literals stop being used. Then delete them from
# secrets.server.ts.
#
# Comma-separated emails allowed into the console. The FIRST one is the account
# that gets bootstrapped on first boot.
ADMIN_EMAILS=
# Password for the bootstrapped admin account. Changing it and restarting
# re-syncs the credential — the console is the only way back in, so it never
# locks itself out.
ADMIN_PASSWORD=
# Optional: handle for the admin's own (hidden, suspended) profile row.
ADMIN_HANDLE=
# Optional: extra Better Auth user IDS allowed in. Used by the preview sandbox's
# synthetic `dev-user`; emails are the normal mechanism.
# e.g. ADMIN_IDS=user_abc123,user_def456
ADMIN_IDS=
# Set to 1 to remove the admin surface entirely — /api/admin then 404s, exactly
# as if the routes did not exist. Do this in production.
ADMIN_DISABLED=

# Every profile the tool creates carries is_ai = true plus full provenance, and
# the console has a "Purge generated" action that deletes the whole synthetic
# cohort in one go. Run that before any production deploy.

# ── Trusted origins (optional) ──────────────────────────────────────────────
# Comma-separated list of extra origins allowed to make cookie-authenticated
# POSTs (CSRF defence). The app's own origin is always allowed. Useful when you
# run the PWA from a second domain or through a preview proxy.
# e.g. TRUSTED_APP_ORIGINS=https://strut.app,https://www.strut.app
TRUSTED_APP_ORIGINS=

# ── Seed chat AI (optional; without it bots send short canned lines) ────────
# Seeded profiles reply in their own persona via an OpenAI-compatible chat
# model. The provider is auto-picked from whichever key is set, in this order:
#
#  • FREE to start (recommended):
#      Groq       — console.groq.com  →  create API key  →  GROQ_API_KEY
#                   (fast, free tier; model llama-3.3-70b-versatile)
#      OpenRouter — openrouter.ai     →  free :free models → OPENROUTER_API_KEY
#  • Edgy/explicit chat (least likely to refuse this app's content):
#      xAI Grok   — console.x.ai      →  XAI_API_KEY  (paid but cheap)
#
# Override the model with AI_MODEL, or point at any OpenAI-compatible gateway
# with AI_API_KEY + AI_API_BASE (+AI_MODEL). The app tries several CURRENT model
# ids in turn and skips any that is deprecated or refuses, so a retired model id
# won't silently fall back to canned replies.
GROQ_API_KEY=
OPENROUTER_API_KEY=
XAI_API_KEY=
GEMINI_API_KEY=
# AI Horde (free, crowdsourced uncensored text AND image models).
#
# Horde is the only provider we use that will generate both the persona/bio
# (uncensored RP models like Skyfall-31B, Behemoth-X-123B) and the profile
# photo (ICBINP, Realistic Vision, Juggernaut XL) behind ONE key. It censors
# exactly one thing horde-wide — CSAM — and otherwise defers to each volunteer
# worker's own censorlist.
#
# Two things to know before you rely on it:
#   • It is ASYNC. Submit a job, poll the status URL. Never request/response.
#   • Queue depth is a function of kudos. The anonymous key works, but sits at
#     the back — measured ~40 minutes behind ~200 jobs. A FREE registered key
#     from https://aihorde.net/register jumps most of the way up, and running a
#     worker earns kudos continuously. For the seed-profile tool, register.
#   • Text jobs are capped at max_length 512. Above that the Horde requires the
#     account to already hold the full kudos cost up front ("This request
#     requires 1180.95 kudos to fulfil"); at or below 512 the cost is deferred
#     and a low-balance account is still served.
#   • Images: 512x768 @ 22 steps costs ~7 kudos. Prefer photoreal checkpoints
#     (ICBINP, Realistic Vision) — the popular anime ones return solid black
#     frames for this app's prompts.
#
# ⚠️  A fallback key is committed in src/lib/server/secrets.server.ts. Setting
# this variable overrides it; do that and then delete the literal.
#
# Used by: bot chat replies, and /admin seed-profile generation.
AIHORDE_API_KEY=
# Optional: force one specific model id for the active provider.
# e.g. AI_MODEL=moonshotai/kimi-k2-instruct  (a more permissive Groq option)
AI_MODEL=
